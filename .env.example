# Скопируйте в .env и заполните реальными значениями. Файл .env НЕ коммитить.

# Ключ авторизации GigaChat (Authorization key из личного кабинета, base64).
GIGACHAT_AUTH_KEY=

# Модель GigaChat. По умолчанию "GigaChat" (базовая) — она доступна на бесплатном
# тарифе GIGACHAT_API_PERS и расходует меньше токенов. Pro/Max требуют платного доступа.
#   GIGACHAT_MODEL=GigaChat        # база (по умолчанию)
#   GIGACHAT_MODEL=GigaChat-Pro    # точнее, но дороже и не на free-тарифе
GIGACHAT_MODEL=GigaChat

# Scope авторизации OAuth. Физлицо (freemium) — GIGACHAT_API_PERS (по умолчанию).
# Корпоративный ключ — GIGACHAT_API_B2B (или GIGACHAT_API_CORP). Должен совпадать
# с тем, под который выпущен GIGACHAT_AUTH_KEY, иначе OAuth вернёт ошибку scope.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Подмешивать ли в ответ результаты поиска по сайту Минздрава (1/0).
# По умолчанию выключено: экономит токены и время, убирает посторонний шум.
ENABLE_MINZDRAV=0

# Секрет Flask для подписи сессий. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Пути (значения по умолчанию подходят).
RAG_DOCS_PATH=./rag_docs
PROMPT_PATH=./prompt.txt

# База данных. По умолчанию — SQLite-файл рядом с приложением.
# Для PostgreSQL: добавьте "psycopg[binary]" в requirements.txt и укажите, напр.:
#   DATABASE_URL=postgresql+psycopg://dms:PASSWORD@127.0.0.1:5432/dms
DATABASE_URL=sqlite:///dms_assistant.db

# Включить debug локального dev-сервера (НЕ для прода): FLASK_DEBUG=1
FLASK_DEBUG=0
