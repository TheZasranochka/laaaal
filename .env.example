# Скопируйте в .env и заполните реальными значениями. Файл .env НЕ коммитить.

# Ключ авторизации GigaChat (Authorization key из личного кабинета, base64).
GIGACHAT_AUTH_KEY=

# Секрет Flask для подписи сессий. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Пути (значения по умолчанию подходят).
RAG_DOCS_PATH=./rag_docs
PROMPT_PATH=./prompt.txt

# База данных. По умолчанию — SQLite-файл рядом с приложением.
# Для PostgreSQL: добавьте "psycopg[binary]" в requirements.txt и укажите, напр.:
#   DATABASE_URL=postgresql+psycopg://dms:PASSWORD@127.0.0.1:5432/dms
DATABASE_URL=sqlite:///dms_assistant.db

# Включить debug локального dev-сервера (НЕ для прода): FLASK_DEBUG=1
FLASK_DEBUG=0
